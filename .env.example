# Copy this file to .env and choose your own password.
# .env is ignored by git, so real values never end up on GitHub.

# Used by docker-compose.yml to create the Postgres user and database
POSTGRES_USER=jobqueue
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobqueue

# Used by database.py to connect (must match the values above; port 5433 on your machine)
DATABASE_URL=postgresql+psycopg2://jobqueue:change-me@localhost:5433/jobqueue
